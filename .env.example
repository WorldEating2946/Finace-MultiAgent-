# ==================================================
# FinaceAgent 环境变量模板
#
# 说明:
# 1. 本文件提交 Git，用于团队统一配置模板
# 2. 实际开发请复制为 .env
# 3. .env 禁止提交
# ==================================================


# ==================================================
# PostgreSQL 数据库配置
# ==================================================

# 数据库名称
POSTGRES_DB=finance_agent

# 数据库用户名
POSTGRES_USER=finance

# 数据库密码
POSTGRES_PASSWORD=<set_your_db_password>


# ==================================================
# Redis 配置
# ==================================================

# Redis 地址
REDIS_HOST=localhost

# Redis 映射端口
REDIS_PORT=16379


# ==================================================
# Application 配置
# ==================================================

# 应用运行环境
APP_ENV=development

# 服务端口
APP_PORT=8000


# ==================================================
# LLM 配置
# ==================================================

# 大模型 API Key
# 开发者自行填写，不提交
OPENAI_API_KEY=

# DeepSeek API Key
# 开发者自行填写，不提交
DEEPSEEK_API_KEY=


# ==================================================
# Security 配置
# ==================================================

# JWT密钥
# 生产环境必须改成一个足够长的随机串（≥32 字节）
JWT_SECRET_KEY=<generate_a_long_random_secret>

# ==================================================
# RAG 配置
# ==================================================

# 向量库持久化根目录（各 company 独立子目录：<path>/<company>/）
RAG_VECTOR_STORE_PATH=data/vector_store

# retrieve 默认返回条数（精排后）
RAG_DEFAULT_TOP_K=5

# Hybrid 召回候选数（供 CrossEncoder 精排；Top-K sweep 实测 20 最优）
RAG_RETRIEVE_TOP_K=20

# 精排后返回条数
RAG_RERANK_TOP_K=5

# Embedding 模型：bge-m3（默认）/ dummy（开发占位，无 torch 依赖）
EMBEDDING_MODEL=bge-m3

# Embedding 推理设备：auto（默认，GPU 优先；无 CUDA torch 自动回退 CPU）/ cuda / cpu
RAG_EMBEDDING_DEVICE=auto

# Hybrid 检索：Dense(BGE-M3) + Sparse(BM25) + RRF 融合
RAG_HYBRID=true

# 精排模型：dummy（直通无依赖）/ metadata（MetadataReranker）/
# 本地 bge-reranker-v2-m3 路径
RAG_RERANKER_MODEL=app/models/reranker/bge-reranker-v2-m3

# PDF OCR fallback（文本层损坏时用 Tesseract chi_sim，需安装 Tesseract 二进制）
RAG_OCR=true

# ── Research Memory checkpoint 后端（PR39+PR41）─────────────────
# memory | sqlite | postgres
RAG_CHECKPOINT_STORE=memory

# SqliteSaver 数据库文件（仅 RAG_CHECKPOINT_STORE=sqlite 时用）
RAG_CHECKPOINT_DB_PATH=data/checkpoints.db

# ── PostgreSQL（PR41 生产 Runtime）────────────────────────────
# 业务库 DSN（research_tasks / research_reports 表）
# 例：postgresql://finance:finance123@localhost:5433/finance_agent
DATABASE_URL=

# LangGraph checkpoint DSN（langgraph schema 下 checkpoint 表；可与业务库同库）
# 例：postgresql://finance:finance123@localhost:5433/finance_agent
CHECKPOINT_DB_URL=

# ── Runtime Reliability（PR42a Worker Recovery）────────────────
# worker 心跳周期（秒）
RUNTIME_HEARTBEAT_INTERVAL=10.0
# lease 过期阈值（秒）：heartbeat_at 超时判 stale，可被接管
RUNTIME_LEASE_TTL=30.0
# reaper 扫描周期（秒）：孤儿接管 + watchdog 巡检
RUNTIME_REAPER_INTERVAL=15.0
# watchdog 单代次上限（秒）：从 claimed_at 起算，超时判 failed
RUNTIME_MAX_RUN_SECONDS=600.0
# 单任务最大认领代次：超过判 failed，防无限 crash 循环
RUNTIME_MAX_ATTEMPTS=3
# worker 标识（默认 hostname:pid；多进程部署可显式覆盖）
RUNTIME_WORKER_ID=

# ── Runtime Worker Pool（PR43 Redis 队列 + 多 Worker）──────────
# 并发 worker 数量（调度/并发节流）
RUNTIME_WORKER_COUNT=4
# Redis 连接 URL（任务调度队列；任务状态仍以 PostgreSQL 为准）
# 端口与上方 REDIS_PORT 一致（docker compose 映射 16379）
RUNTIME_REDIS_URL=redis://localhost:16379
# Redis 队列 key（RPUSH 入队 / BLPOP 出队）
RUNTIME_REDIS_QUEUE_KEY=finance:research:queue
# 优雅关闭超时（秒）：等待在途任务完成，超时强制取消
RUNTIME_SHUTDOWN_TIMEOUT=30.0

# ── Metadata Rerank 融合权重（PR33）───────────────────────────
# final = α*ce_norm + β*section_signal + γ*keyword_signal
# 按公司配置（JSON）：未配置公司 → 纯 CrossEncoder（零回归）
# 例：RAG_METADATA_COMPANY_WEIGHTS={"小米":"0.90,0.08,0.02"}
RAG_METADATA_COMPANY_WEIGHTS={}

# ── Vector Backend（PR44.4 生产向量后端切换）──────────────────
# faiss（默认，本地开发/离线评测/紧急回滚）/ milvus（生产）
# 切换 milvus 需先跑 migrate + verify（PR44.3.2/3）
RAG_VECTOR_BACKEND=faiss

# ── Milvus（PR44.3.1 Milvus Adapter，仅 RAG_VECTOR_BACKEND=milvus 时用）──
MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION_NAME=finance_knowledge
MILVUS_DIM=1024
# 冻结 = finance_agent；禁止传 "" 或 default（共享环境只新建不碰他库）
MILVUS_DB_NAME=finance_agent

# ── Multi-source Fusion（PR35）─────────────────────────────────
# 参与多源知识融合的文档语义类型（JSON 数组）
RAG_SOURCE_TYPES=["annual_report"]

# ── Research Intent（PR36）────────────────────────────────────
# 意图解析模式：rule（默认）/ llm（留作增强）/ off（直通兜底）
RAG_RESEARCH_PARSER=rule

# 已知公司列表（意图目标抽取用，JSON 数组）
RAG_KNOWN_COMPANIES=["小米","宁德时代","小鹏汽车"]

# ── Query Rewrite（PR31）──────────────────────────────────────
# 查询改写模式：rule（默认，规则同义词，零成本）/ llm / off
RAG_QUERY_REWRITER=rule

# LLM 改写（DeepSeek OpenAI 兼容；密钥 DEEPSEEK_API_KEY 见上）
LLM_REWRITE_BASE_URL=https://api.deepseek.com
LLM_REWRITE_MODEL=deepseek-v4-flash
LLM_REWRITE_TEMPERATURE=0.5
# LLM 生成的额外变体数（不含原始 query）
LLM_REWRITE_MAX_QUERIES=3

# ── Financial Agent（PR #58 合并）──────────────────────────────
# 本地财务数据文件（可选；留空默认 app/data/fixtures/sample_company.json）
# 真实公司数据：app/data/000333_美的集团.json / 002594_比亚迪.json /
#              300750_宁德时代.json / 600519_贵州茅台.json
FINANCE_AGENT_DATA_FILE=

# DeepSeek 兼容接口（Financial Agent LLM 解读；密钥复用上方 DEEPSEEK_API_KEY）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-v4-flash

# 应用监听地址（Financial Agent 独立入口 app/main.py 使用）
APP_HOST=0.0.0.0

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
